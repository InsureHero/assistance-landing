# -----------------------------------------------------------------------------
# Backend (API Postventa) – develop: https://develop.insurehero.io
# -----------------------------------------------------------------------------
# URL base del backend (OTP, risk-items, metadata, post-sales usan esta variable).
# Local: http://localhost:3002
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase (lectura server-only del tope de beneficiarios por producto)
# -----------------------------------------------------------------------------
# URL del proyecto Supabase.
NEXT_PUBLIC_SUPABASE_URL=
# Service role key — SERVER ONLY. Nunca exponer al cliente ni con prefijo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Opcional
# -----------------------------------------------------------------------------
# URL de la página de política de privacidad (enlace en el paso de viajeros).
# NEXT_PUBLIC_PRIVACY_POLICY_URL=/privacy-policy
